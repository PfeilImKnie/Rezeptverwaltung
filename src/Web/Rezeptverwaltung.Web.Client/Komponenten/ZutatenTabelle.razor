<table class="zutaten">
    <thead>
        <tr><th>Zutat</th><th class="zahl">Menge</th></tr>
    </thead>
    <tbody>
        @foreach (var zutat in Zutaten)
        {
            <tr><td>@zutat.Bezeichnung</td><td class="zahl">@Zahlen.Anzeigen(zutat.Gramm) g</td></tr>
        }
    </tbody>
    <tfoot>
        <tr><th>Gesamt</th><th class="zahl">@Zahlen.Anzeigen(GesamtGramm) g</th></tr>
    </tfoot>
</table>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Zutat> Zutaten { get; set; } = [];

    [Parameter, EditorRequired] public decimal GesamtGramm { get; set; }
}
